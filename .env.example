# ==============================================================================
# TORK AI BOT & VISUALIZER (KAZAKHSTAN MVP 1.0) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=800000000:AAH_example_token_here
# Группа/чат для приема готовых лидов и заявок на тест-драйв в Казахстане
MANAGER_CHAT_ID=-100200300400

# --- DATABASE (POSTGRESQL 16) ---
POSTGRES_USER=tork_admin
POSTGRES_PASSWORD=supersecret_tork_kz_pass
POSTGRES_DB=tork_bot_db
POSTGRES_PORT=5432

# --- N8N SYSTEM SETTINGS ---
N8N_ENCRYPTION_KEY=tork-bot-kz-secret-encryption-key-2026
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# --- GOOGLE GEMINI UNIFIED API (VISION + LOGIC + IMAGE GENERATION) ---
# Единый API ключ Google Gemini (используется для VLM и для генерации фотомонтажа)
VLM_API_KEY=AIzaSy_your_gemini_api_key_here

# 1. Текстовая логика и Vision-анализ интерьера санузла:
VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VLM_MODEL_NAME=gemini-4.0-argon

# 2. Модель фотомонтажа и генерации изображений (Google Gemini REST API):
# Нативная модель: gemini-3.1-flash-image (Nano Banana)
IMAGE_EDIT_MODEL=gemini-3.1-flash-image
IMAGE_EDIT_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent
IMAGE_EDIT_API_KEY=AIzaSy_your_gemini_api_key_here  # Совпадает с VLM_API_KEY при работе через Google Gemini

# --- АЛЬТЕРНАТИВНЫЕ ПРОВАЙДЕРЫ (ДЛЯ СПРАВКИ) ---
# Вариант OpenAI (DALL-E / gpt-image-2):
# IMAGE_EDIT_API_URL=https://api.openai.com/v1/images/edits
# IMAGE_EDIT_API_KEY=sk-proj-your_openai_key_here
# IMAGE_EDIT_MODEL=gpt-image-2

# Локальный сервер после деплоя (Ollama на сервере дистрибьютора):
# VLM_BASE_URL=http://host.docker.internal:11434/v1
# VLM_API_KEY=ollama
# VLM_MODEL_NAME=qwen3.8:27b-iq4_xs

# --- LIMITS & REGIONAL SETTINGS (KAZAKHSTAN ONLY - KZT) ---
# 1 = Астана (ТОО "Tork Kazakhstan Distribution Astana")
# 2 = Алматы (ТОО "Tork Distribution Almaty")
# 3 = Шымкент (ТОО "Tork South Industrial KZ")
DEFAULT_DISTRIBUTOR_ID=1
MAX_RENDERS_PER_USER_DAY=5

# --- SERVICES ---
GOTENBERG_URL=http://gotenberg:3000

